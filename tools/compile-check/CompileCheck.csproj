<!--
  Проверка компиляции C# без Unity (для облачных сессий Claude): компилирует скрипты
  против эталонных сборок UnityEngine/UnityEditor из NuGet. Запуск: tools/compile-check/check.sh
  Сборки 2021.x старше Unity 6, поэтому ошибки про API, которых там нет
  (NamedBuildTarget и т.п.), разбираются вручную.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);MSB3277;CS0649;CS0414</NoWarn>
    <AssemblyName>CompileCheck.$(Mode)</AssemblyName>
    <BaseIntermediateOutputPath>obj/$(Mode)/</BaseIntermediateOutputPath>
    <OutputPath>bin/$(Mode)/</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Mode)'=='Player'">
    <DefineConstants>$(DefineConstants);UNITY_WEBGL;YANDEX_GAMES</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Mode)'=='Editor'">
    <DefineConstants>$(DefineConstants);UNITY_EDITOR;UNITY_WEBGL;YANDEX_GAMES</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_Game/Scripts/**/*.cs" />
    <Reference Include="refs/engine/*.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(Mode)'=='Editor'">
    <Compile Include="../../Assets/_Game/Editor/**/*.cs" />
    <Compile Include="shims/*.cs" />
    <Reference Include="refs/editor/UnityEditor.dll" Private="false" />
  </ItemGroup>
</Project>
